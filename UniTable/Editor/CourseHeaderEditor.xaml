<Window x:Class="UniTable.Editor.CourseHeaderEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UniTable.Editor" xmlns:unitable="clr-namespace:UniTable" 
        xmlns:comp="clr-namespace:UniTable.Components"
        mc:Ignorable="d"
        Style="{StaticResource ContrastWindowStyle}"
        Title="Edit Course Properties &amp; Data" Width="800" SizeToContent="Height">
    <Window.Resources>
        <comp:ColorToStringConverter x:Key="ColorToStringConverter"/>
    </Window.Resources>
    <d:Window.DataContext>
        <unitable:CourseHeader/>
    </d:Window.DataContext>
    <DockPanel Margin="6">
        <Button x:Name="OkButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="6 6 6 6" Width="150" 
                Foreground="{StaticResource NewColourKey}" IsDefault="True" Click="OkButton_Click">Ok</Button>
        <GroupBox Header="Importer" DockPanel.Dock="Top">
            <ListBox Style="{StaticResource ControlPanelListBoxStyle}" Margin="6">
                <Label Tag="Importer Type">Adelaide University 2026 (v1.5)</Label>
                <Grid Tag="Import Data" ToolTip="You may either enter in the URL of the webpage of the course, or load HTML from a file on the disk or the clipboard. The URL can also be generated by entering in the course code.">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Fetch URL" Command="{Binding FetchFromUrlCommand}" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="60" />
                    <TextBox Text="{Binding Url}" Foreground="{StaticResource FileColourKey}" Grid.ColumnSpan="2" Margin="2,2,62,2" />
                    <Button Content="Load From File" Command="{Binding FetchFromFileCommand}" Grid.Row="1" Grid.Column="0"></Button>
                    <Button Content="Update From Clipboard" Command="{Binding UpdateFromClipboardCommand}" Grid.Row="1" Grid.Column="1"></Button>
                </Grid>
                <TextBlock Tag="Importer Status" Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="2" />
            </ListBox>
        </GroupBox>
        <GroupBox Header="Course Properties">
            <ListBox Style="{StaticResource ControlPanelListBoxStyle}" Margin="6">
                <TextBox Tag="Code" Text="{Binding Code}" ToolTip="The alphabetical code of the course"/>
                <TextBox Tag="Number" Text="{Binding Number}" ToolTip="The number of the course"/>
                <TextBox Tag="Name" Text="{Binding Name}" ToolTip="Long name of the course"/>
                <DockPanel Tag="Colour" ToolTip="Colour of the course as shown on this timetable" Margin="2">
                    <Button Content="Change" Margin="0" DockPanel.Dock="Right" Command="{Binding ChangeColourCommand}" Width="50"></Button>
                    <TextBox Margin="0" Text="{Binding Color, Converter={StaticResource ColorToStringConverter}}">
                        <TextBox.Background>
                            <SolidColorBrush Color="{Binding Color}"/>
                        </TextBox.Background>
                    </TextBox>
                </DockPanel>
                <CheckBox Content="Is Course Visible on Timetable" IsChecked="{Binding IsEnabled}"/>
            </ListBox>

        </GroupBox>
        <GroupBox Header="{Binding ClassTypes.Count}" HeaderStringFormat="{}Class List ({0} Loaded)">
            <ItemsControl ItemsSource="{Binding ClassTypes}" Margin="6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type unitable:ClassType}">
                        <DockPanel>
                            <TextBlock Text="{Binding}" DockPanel.Dock="Top" Margin="2 0"/>
                            <ComboBox x:Name="ClassSelectbox" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
              IsDropDownOpen="{Binding IsFocused}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type unitable:UniClass}">
                                        <Grid x:Name="UniClassRootGrid" HorizontalAlignment="Stretch" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Section" Width="Auto"/>
                                                <ColumnDefinition SharedSizeGroup="Number" Width="Auto"/>
                                                <ColumnDefinition SharedSizeGroup="Space" Width="Auto"/>
                                                <ColumnDefinition SharedSizeGroup="SessionCount" Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Section}" TextElement.FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Number}" Opacity="0.7" Margin="4,0,4,0" Grid.Column="1"/>
                                            <TextBlock Text="{Binding Space}" Opacity="0.7" Grid.Column="2" ToolTip="Taken Seats / Total Seats"/>
                                            <TextBlock Text="{Binding SessionCount, StringFormat={}[{0}]}" ToolTip="Number of sessions this class has" Margin="4,0,4,0" Foreground="CornflowerBlue" Grid.Column="3"/>
                                            <TextBlock Text="{Binding Timings}" TextTrimming="CharacterEllipsis" Opacity="0.7" Grid.Column="4" ToolTip="{Binding Timings}"/>
                                            <TextBlock x:Name="Note" Text="{Binding Note}" Foreground="HotPink" MaxWidth="300" TextWrapping="Wrap" FontSize="8" Grid.Row="1" Grid.ColumnSpan="5"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Note}" Value="">
                                                <DataTrigger.Setters>
                                                    <Setter TargetName="Note" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
    </DockPanel>
</Window>
